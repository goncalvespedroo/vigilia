# Copie para supabase/functions/.env (ignorado pelo git) e preencha.
# Envie para o Supabase com: npx supabase secrets set --env-file supabase/functions/.env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Segredo compartilhado com o pg_cron (o mesmo valor vai para o Vault como vigilia_cron_secret)
VIGILIA_CRON_SECRET=
# Opcional: contato VAPID (mailto: ou https://). Padrão: URL do projeto.
# VAPID_SUBJECT=
