# Copie para .env e preencha. Nunca commite o .env.
# Supabase → Project Settings → API (ou "Connect")
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave pública: "publishable key" (sb_publishable_...) ou a "anon key" legada.
# NUNCA coloque aqui a service_role / secret key — tudo com prefixo VITE_ vai para o navegador.
VITE_SUPABASE_ANON_KEY=

# Web Push: chave VAPID pública. A privada fica só em supabase/functions/.env
# (enviada com `npx supabase secrets set --env-file supabase/functions/.env`).
VITE_VAPID_PUBLIC_KEY=
